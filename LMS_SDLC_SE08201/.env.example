DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=log
# Biến môi trường chứa API Key của Google Gemini
GEMINI_API_KEY=